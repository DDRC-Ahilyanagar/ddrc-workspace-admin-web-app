# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=ddrc_surveys

# Prisma Database URL (optional, for Prisma migrations)
# DATABASE_URL=mysql://root:@127.0.0.1:3306/ddrc_surveys

# SMS Configuration
SMS_URL=http://msg.icloudsms.com/rest/services/sendSMS/sendGroupSms
SMS_AUTH_KEY=your_sms_auth_key
SMS_SENDER_ID=ddrcvk
SMS_ROUTE_ID=1
SMS_OTP_TEMPLATE=Your OTP is {otp}. Valid for {minutes} minutes.

# OTP Configuration
OTP_EXPIRY_MINUTES=5

# Next.js Public API URL
NEXT_PUBLIC_API_URL=https://surveyapi.somethign.right/api

# Server Configuration (for network access)
# HOSTNAME=0.0.0.0
# PORT=3000
