model CasteCategory {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique @db.VarChar(50)
  nameMarathi           String    @map("name_marathi") @db.VarChar(255)
  nameEnglish           String    @map("name_english") @db.VarChar(255)
  reservationPercentage Decimal?  @default(0.00) @map("reservation_percentage") @db.Decimal(5, 2)
  status                Status    @default(Active)
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  castes                Caste[]

  @@map("caste_categories")
}

model Caste {
  id          Int           @id @default(autoincrement())
  categoryId  Int           @map("category_id")
  nameMarathi String        @map("name_marathi") @db.VarChar(255)
  nameEnglish String        @map("name_english") @db.VarChar(255)
  status      Status        @default(Active)
  sortOrder   Int?          @default(0) @map("sort_order")
  createdAt   DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  category    CasteCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "fk_category")
  @@map("castes")
}

enum Status {
  Active
  Inactive
}
